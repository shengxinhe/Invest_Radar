# DeepSeek API Key（必填，或启动后在 App「我的设置」里填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 可选：模型与地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_CHEAP=deepseek-chat
# DEEPSEEK_MODEL_STRONG=deepseek-reasoner

# ============ 服务配置 ============
# 监听地址
#   127.0.0.1 = 只有本机能访问（推荐，配合 Tailscale Serve 给手机用）
#   0.0.0.0   = 同一 WiFi 下的设备能直接访问
RADAR_HOST=127.0.0.1
RADAR_PORT=8000

# 允许的前端来源（逗号分隔）
# 使用 Tailscale 时，把你的 ts.net 域名加进来
# 例：https://你的设备名.你的tailnet.ts.net
RADAR_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173,https://localhost,capacitor://localhost
